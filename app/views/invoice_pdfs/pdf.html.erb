<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <style>
      .container {
        margin: auto;
        font-size: 12px;
      }

      .col-md-12 {

      }

      .col-md-6 {
        width: 49%;
        display: inline-block;
      }

      .col-xs-4 {
        width: 33%;
      }

      .col-xs-2 {
        width: 16%;
      }

      .col-md-3 {
        width: 24%;
        display: inline-block;
      }

      .left {
        float: left;
      }

      .left {
        padding-right: 5px;
      }

      .right {
        float: right;
      }

      .text-right {
        text-align: right;
      }

      dt {
        float: left;
        width: 100px;
        clear: left;
        text-align: right;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: bold;
        line-height: 1.42857;
      }

      dd {
        margin-left: 120px;
        line-height: 1.42857;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
      }

      th {
        text-align: left;
        border: 0px;
        border-top: 1px solid #DDD;
        padding: 6px;
      }

      thead th {
        border-bottom: 2px solid #DDD;
        border-top: 0px;
      }

      td {
        border-top: 1px solid #DDD;
      }

      td {
        padding: 6px;
      }

      .no-border {
        border: 0px;
      }

      hr {
        height: 1px;
        border: 0;
        color: #DDD;
        background-color: #DDD;
      }

      .clear {
        clear: both;
      }

      .pull-down {
        margin-top: 50px;
      }

      #header {
        position: relative;
        min-height: 100px;
      }

      img {
        width: 106px;
        height: 102px;
      }

      #header-content {
        position: absolute;
        bottom: 0;
      }

      #footer {
        position: absolute;
        bottom: 0px;
        width: 99%;
      }

      h1 {
        margin-bottom: 5px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div id="header" class="row">
        <div class="col-sm-6 left">
          <div id="header-content">
            <h1>
              <%= @pdf %>
            </h1>
          </div>
        </div>
        <div class="col-sm-6 right">
          <img src="<%= Rails.root %>/public/eis-logo-black-et.png">
        </div>
      </div>
      <div class="clear">
      </div>
      <hr>
      <div class="row">
        <div class="col-md-6 left">
          <h4>
            Details
          </h4>
          <hr>
          <dl class="dl-horizontal">
            <dt><%= t(:issue_date) %></dt>
            <dd><%= l(@pdf.issue_date, format: "%Y-%m-%d") if @pdf.issue_date %></dd>
            <% if @pdf.cancelled? %>
              <dt><%= t('attributes.cancelled_at') %></dt>
              <dd><%= l(@pdf.cancelled_at, format: "%Y-%m-%d") if @pdf.cancelled_at %></dd>
            <% end %>
            <dt><%= t(:due_date) %></dt>
            <% if @pdf.cancelled? %>
              <dd><%= t(:cancelled) %></dd>
            <% else %>
              <dd><%= l(@pdf.due_date, format: "%Y-%m-%d") if @pdf.due_date %></dd>
            <% end %>
            <dt><%= t('attributes.receipt_date') %></dt>
            <% if @pdf.paid? %>
              <dd><%= l(@pdf.receipt_date, format: "%Y-%m-%d") if @pdf.receipt_date %></dd>
            <% elsif @pdf.cancelled? %>
              <dd><%= t(:cancelled) %></dd>
            <% else %>
              <dd class="text-danger"><%= t(:unpaid) %></dd>
            <% end %>
            <dt><%= t(:payment_term) %></dt>
            <dd>Prepayment</dd>
            <dt><%= t(:invoice_number) %></dt>
            <dd><%= @pdf.invoice[:number] %></dd>
            <% if @pdf.invoice[:description].present? %>
              <dt><%= t(:description) %></dt>
              <dd><%= @pdf.invoice[:description] %></dd>
            <% end %>
            <dt><%= t('attributes.reference_no') %></dt>
            <dd><%= @pdf.invoice[:reference_no] %></dd>
          </dl>
        </div>
        <div class="col-md-6 right">
          <h4><%= t(:client) %></h4>
          <hr>
          <dl class="dl-horizontal">
            <dt><%= t(:name) %></dt>
            <dd><%= @pdf.invoice[:buyer_name] %></dd>
            <dt><%= t(:reg_no) %></dt>
            <dd><%= @pdf.invoice[:buyer_reg_no] %></dd>
            <% if @pdf.invoice[:buyer_vat_no].present? %>
              <dt><%= t('attributes.vat_no') %></dt>
              <dd><%= @pdf.invoice[:buyer_vat_no] %></dd>
            <% end %>
            <% if @pdf.buyer_address.present? %>
              <dt><%= t('attributes.address') %></dt>
              <dd><%= @pdf.buyer_address %></dd>
            <% end %>
            <% if @pdf.buyer_country.present? %>
              <dt><%= t(:country) %></dt>
              <dd><%= @pdf.buyer_country %></dd>
            <% end %>
            <% if @pdf.invoice[:buyer_phone].present? %>
              <dt><%= t(:phone) %></dt>
              <dd><%= @pdf.invoice[:buyer_phone] %></dd>
            <% end %>
            <% if @pdf.invoice[:buyer_url].present? %>
              <dt><%= t(:url) %></dt>
              <dd><%= @pdf.invoice[:buyer_url] %></dd>
            <% end %>
            <% if @pdf.invoice[:buyer_email].present? %>
              <dt><%= t(:email) %></dt>
              <dd><%= @pdf.invoice[:buyer_email] %></dd>
            <% end %>
          </dl>
        </div>
      </div>
      <div class="clear">
      </div>
      <div class="row pull-down">
        <div class="col-md-12">
          <div class="table-responsive">
            <table class="table table-hover table-condensed">
              <thead>
                <tr>
                  <th class="col-xs-4"><%= t(:description) %></th>
                  <th class="col-xs-2"><%= t(:unit) %></th>
                  <th class="col-xs-1"><%= t('attributes.quantity') %></th>
                  <th class="col-xs-3"><%= t(:price) %></th>
                  <th class="col-xs-2"><%= t(:total) %></th>
                </tr>
              </thead>
              <tbody>
                <% @pdf.items.each do |invoice_item| %>
                  <tr>
                    <td><%= invoice_item[:description] %></td>
                    <td><%= invoice_item[:unit] %></td>
                    <td><%= invoice_item[:quantity] %></td>
                    <td><%= @pdf.currency(invoice_item[:price]) %></td>
                    <td><%= "#{@pdf.currency((invoice_item[:price].to_d * invoice_item[:quantity].to_d).round(3))} #{@pdf.invoice[:currency]}" %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="3">
                  </th>
                  <th><%= t('attributes.subtotal') %></th>
                  <td><%= number_to_currency @pdf.subtotal %></td>
                </tr>
                <tr>
                  <th class="no-border" colspan="3">
                  </th>
                  <th><%= "VAT #{number_to_percentage(@pdf.invoice[:vat_rate], precision: 1)}" %></th>
                  <td><%= number_to_currency @pdf.vat_amount %></td>
                </tr>
                <tr>
                  <th class="no-border" colspan="3">
                  </th>
                  <th><%= t(:total) %></th>
                  <td><%= number_to_currency @pdf.total %></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
      <div id="footer">
        <hr>
        <div class="row">
          <div class="col-md-3 left">
            <%= @pdf.invoice[:seller_name] %>
            <br>
            <%= @pdf.seller_address %>
            <br>
            <%= @pdf.seller_country %>
            <br>
            <%= "#{t('reg_no')} #{@pdf.invoice[:seller_reg_no]}" %>
            <br>
            <%= "#{t('attributes.vat_no')} #{@pdf.invoice[:seller_vat_no]}" %>
          </div>
          <div class="col-md-3 left">
            <%= @pdf.invoice[:seller_phone] %>
            <br>
            <%= @pdf.invoice[:seller_email] %>
            <br>
            <%= @pdf.invoice[:seller_url] %>
          </div>
          <div class="col-md-3 text-right left">
            <%= t(:bank) %>
            <br>
            <%= t(:iban) %>
            <br>
            <%= t(:swift) %>
          </div>
          <div class="col-md-3 left">
            <%= @pdf.invoice[:seller_bank] %>
            <br>
            <%= @pdf.invoice[:seller_iban] %>
            <br>
            <%= @pdf.invoice[:seller_swift] %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
